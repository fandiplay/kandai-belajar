async function home(){
  const cs=await api('/courses');
  $.innerHTML=`<div class="top"><h2 style="flex:1">Kamu penasaran tentang apa?</h2><span class="link" id="lo">Keluar</span></div>
  <textarea id="pr" rows="2" placeholder="Aku ingin belajar..."></textarea><button class="btn" id="mk">BUAT ROADMAP</button>
  ${cs.map(c=>`<div class="card" data-id="${c.id}" style="cursor:pointer"><b>${esc(c.title)}</b><br><small>${c.done}/${c.total} pelajaran</small></div>`).join('')}`;
  g('lo').onclick=logout;
  $.querySelectorAll('[data-id]').forEach(el=>el.onclick=()=>course(el.dataset.id));
  g('mk').onclick=async()=>{const p=g('pr').value.trim();if(!p)return;g('mk').disabled=true;g('mk').textContent='Menyusun roadmap...';
    try{const d=await api('/courses',{prompt:p});course(d.id)}catch(e){alert(e.message);home()}};
}
async function course(id){
  const c=await api('/courses/'+id);let last=-1,open=c.lessons.findIndex(l=>!l.done),h='';
  c.lessons.forEach((l,i)=>{
    if(l.unit_idx!==last){last=l.unit_idx;h+=`<div class="unit">${l.unit_idx+1}. ${esc(l.unit_title)}</div>`}
    const st=l.done?'done':(i===open?'':'lock'),ic=l.done?'✓':(i===open?'▶':'🔒'),off=[0,40,70,40,0][i%5];
    h+=`<div class="node" style="margin-left:${off}px"><button class="dot ${st}" ${st==='lock'?'disabled':''} data-l="${l.id}">${ic}</button><span>${esc(l.title)}</span></div>`;
  });
  $.innerHTML=`<div class="top"><button class="x" id="bk">←</button><h2>${esc(c.title)}</h2></div>${h}`;
  g('bk').onclick=home;$.querySelectorAll('[data-l]').forEach(b=>b.onclick=()=>lesson(b.dataset.l,id));
}
function lesson(id,cid){
  $.innerHTML='<p class="c">Menyiapkan materi, tunggu sebentar...</p>';
  api('/lessons/'+id+'/open',{}).then(L=>{
    let i=0;
    const quizAnswers={};
    let sheetOpen=false;
    const finish=()=>api('/lessons/'+id+'/complete',{}).then(r=>{
      $.innerHTML=`<div class="card c"><h2>Selesai! 🎉</h2><p>Skor kuis: ${r.score}/${r.total}</p><button class="btn" id="b">KEMBALI</button></div>`;
      g('b').onclick=()=>course(cid);
    }).catch(e=>alert(e.message));
    const catSvg=`<svg viewBox="0 0 120 72" role="img" aria-label="Kucing bingung"><path d="M72 18 Q75 5 86 8 L96 19 Q105 18 111 28 L113 42 Q110 54 94 56 L54 56 Q38 55 33 45 Q28 35 38 29 L50 25 L57 13 Q61 8 66 17 Z" fill="#0d1520"/><path d="M81 17 L86 12 L91 20" fill="#fff"/><path d="M48 33 Q54 28 59 34 M70 33 Q76 28 81 34" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/><path d="M62 40 Q66 44 70 40" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"/><path d="M38 48 Q25 53 18 47 Q13 43 17 39" fill="none" stroke="#0d1520" stroke-width="7" stroke-linecap="round"/><path d="M52 54 L48 62 M88 55 L91 62" stroke="#0d1520" stroke-width="7" stroke-linecap="round"/><text x="91" y="12" font-size="22" font-weight="900" fill="#a79bf7" stroke="#0d1520" stroke-width=".7">?</text></svg>`;
    const catShake=()=>{const c=g('cat-help');if(!c)return;c.classList.remove('shake');void c.offsetWidth;c.classList.add('shake')};
    const closeSheet=()=>{sheetOpen=false;const o=g('ask-overlay');if(o)o.remove()};
    const openSheet=()=>{
      if(g('ask-overlay'))return;
      sheetOpen=true;
      const b=L.blocks[i];
      $.insertAdjacentHTML('beforeend',`<div class="ask-overlay" id="ask-overlay"><section class="ask-sheet" role="dialog" aria-modal="true" aria-labelledby="ask-title"><div class="ask-head"><h3 id="ask-title">Bingung bagian mana?</h3><button class="ask-close" id="ask-close" aria-label="Tutup">×</button></div><p style="margin:8px 0;color:#555;font-size:14px">Tanya tentang bagian pelajaran ini.</p><textarea id="ask-question" maxlength="300" rows="3" placeholder="Tulis pertanyaanmu (maks. 300 karakter)..."></textarea><button class="btn" id="ask-send">TANYA</button><div class="ask-answer" id="ask-answer" aria-live="polite"></div></section></div>`);
      g('ask-close').onclick=closeSheet;
      g('ask-overlay').onclick=e=>{if(e.target===g('ask-overlay'))closeSheet()};
      g('ask-send').onclick=async()=>{
        const question=g('ask-question').value.trim();
        if(!question){g('ask-answer').textContent='Tulis pertanyaan dulu ya.';return}
        const btn=g('ask-send');btn.disabled=true;btn.textContent='MEMIKIRKAN...';
        g('ask-answer').textContent='Sedang berpikir...';
        try{
          const r=await api('/lessons/'+id+'/ask',{block_idx:i,question});
          g('ask-answer').innerHTML=DOMPurify.sanitize(marked.parse(String(r.answer||'')))+'<div class="reading-clearance" aria-hidden="true"></div>';
          renderLessonMath(g('ask-answer'));
        }catch(e){g('ask-answer').textContent=e.message||'Maaf, tutor sedang kesulitan menjawab. Coba lagi sebentar ya.'}
        finally{if(g('ask-send')){g('ask-send').disabled=false;g('ask-send').textContent='TANYA'}}
      };
      g('ask-question').focus();
    };
    const show=()=>{
      if(i>=L.blocks.length)return finish();
      const b=L.blocks[i],saved=quizAnswers[i];
      const dots=L.blocks.map((_,n)=>`<span class="lesson-dot ${n===i?'active':''}" aria-label="Blok ${n+1}"></span>`).join('');
      $.innerHTML=`<div class="top"><button class="x" id="x" aria-label="Keluar pelajaran">✕</button><b style="flex:1;text-align:center;font-size:14px">PELAJARAN</b><span style="width:28px"></span></div><div class="lesson-dots" aria-label="Progres pelajaran">${dots}</div><div class="card" id="bd"></div><div id="fb"></div><button class="cat-bubble" id="cat-help" aria-label="Tanya tutor AI">${catSvg}</button><div class="lesson-nav"><button class="btn sec lesson-prev" id="prev" aria-label="Blok sebelumnya" ${i===0?'disabled':''}>&lt;</button><button class="btn lesson-next" id="nx" ${b.type==='quiz'&&!saved?'style="display:none"':''}>LANJUT &gt;</button></div>`;
      g('x').onclick=()=>course(cid);
      g('prev').onclick=()=>{if(i>0){i--;show()}};
      g('nx').onclick=()=>{i++;show()};
      g('cat-help').onclick=openSheet;
      if(b.type==='text'){
        g('bd').innerHTML=DOMPurify.sanitize(marked.parse(b.markdown||''))+'<div class="reading-clearance" aria-hidden="true"></div>';
        renderLessonMath(g('bd'));
      }else{
        g('bd').innerHTML=`<h3>${esc(b.question)}</h3>`+(b.options||[]).map((o,k)=>`<button class="opt" data-k="${k}">${esc(o)}</button>`).join('')+'<div class="reading-clearance" aria-hidden="true"></div>';
        renderLessonMath(g('bd'));
        if(saved){
          g('bd').querySelectorAll('.opt').forEach((o,j)=>{o.disabled=true;if(j===saved.correct)o.classList.add('ok');else if(j===saved.chosen&&!saved.is_correct)o.classList.add('no')});
          g('fb').innerHTML=`<p class="fb">${saved.is_correct?'✅ Benar!':'❌ Kurang tepat.'} ${esc(saved.explanation||'')}</p><div class="reading-clearance" aria-hidden="true"></div>`;
          renderLessonMath(g('fb'));
        }else{
          g('bd').querySelectorAll('.opt').forEach(el=>el.onclick=async()=>{
            if(quizAnswers[i])return;
            const k=+el.dataset.k;g('bd').querySelectorAll('.opt').forEach(o=>o.disabled=true);
            try{
              const r=await api('/lessons/'+id+'/answer',{quiz_idx:i,chosen:k});
              quizAnswers[i]={chosen:k,correct:r.correct,is_correct:!!r.is_correct,explanation:r.explanation||''};
              g('bd').querySelectorAll('.opt').forEach((o,j)=>{if(j===r.correct)o.classList.add('ok');else if(j===k)o.classList.add('no')});
              g('fb').innerHTML=`<p class="fb">${r.is_correct?'✅ Benar!':'❌ Kurang tepat.'} ${esc(r.explanation||'')}</p><div class="reading-clearance" aria-hidden="true"></div>`;
              renderLessonMath(g('fb'));
              g('nx').style.display='block';
              if(!r.is_correct)catShake();
            }catch(e){g('bd').querySelectorAll('.opt').forEach(o=>o.disabled=false);alert(e.message||'Jawaban gagal dikirim. Coba lagi ya.')}
          });
        }
      }
    };
    show();
  }).catch(e=>{alert(e.message);course(cid)});
}
token?home().catch(login):login();
</script></body></html>
